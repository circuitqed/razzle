FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

# Install gcc for C extension and requests for API
RUN apt-get update && apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir requests

# Copy the razzle package and project config
WORKDIR /workspace
COPY pyproject.toml .
COPY razzle/ razzle/

# Copy C MCTS extension source (compiled at build or first boot)
COPY razzle_fast/ razzle_fast/
RUN python3 razzle_fast/_build.py

# Install razzle package in editable mode
RUN pip install --no-cache-dir -e .

# Copy worker and trainer scripts
COPY scripts/worker_selfplay.py scripts/worker_selfplay.py
COPY scripts/trainer.py scripts/trainer.py
COPY scripts/model_arena.py scripts/model_arena.py
COPY scripts/arena_worker.py scripts/arena_worker.py
COPY scripts/run_arena.py scripts/run_arena.py
